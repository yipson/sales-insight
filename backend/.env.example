# Sales Insight — Backend Environment Variables

# Clover API Credentials
CLOVER_CLIENT_ID=your_clover_app_id
CLOVER_CLIENT_SECRET=your_clover_app_secret
CLOVER_ENV=sandbox

# Encryption (32 bytes for AES-256-GCM)
ENCRYPTION_KEY=your-32-char-encryption-key-here

# JWT Secret
JWT_SECRET=your-jwt-secret-here

# Database Connection (used by internal/database/config.go)
DB_HOST=localhost
DB_PORT=5432
DB_USER=sales_insight
DB_PASSWORD=sales_insight_secret
DB_NAME=sales_insight
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Alternative: full DSN string (overrides individual params if set)
# DATABASE_URL=postgres://sales_insight:sales_insight_secret@localhost:5432/sales_insight?sslmode=disable

# Server
API_PORT=8080
FRONTEND_URL=http://localhost:5173
