# Sales Insight — Backend Environment Variables

# Clover API Credentials
CLOVER_CLIENT_ID=your_clover_app_id
CLOVER_CLIENT_SECRET=your_clover_app_secret
CLOVER_ENV=sandbox

# Encryption (32 bytes for AES-256-GCM)
ENCRYPTION_KEY=your-32-char-encryption-key-here

# JWT Secret
JWT_SECRET=your-jwt-secret-here

# Database
DATABASE_URL=postgres://sales_insight:sales_insight_secret@db:5432/sales_insight?sslmode=disable

# Server
API_PORT=8080
FRONTEND_URL=http://localhost:5173
